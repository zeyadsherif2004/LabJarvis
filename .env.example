# LabJarvis configuration. Every setting is read from the environment or from a
# `.env` file in the directory the API is started from (the repository root for
# `python scripts/tasks.py dev`). Values below are the built-in defaults unless
# stated otherwise; copy only what you need to change. Never commit `.env`.
# Source of truth: apps/api/src/labjarvis/settings.py (validated at startup).
#
# Most people choose models in the app instead: Settings saves choices to
# <data dir>/settings.json and they apply on the next start (ADR 0019).
# Recommended split: API keys and deliberate advanced overrides in .env; model
# choices in Settings; nothing LabJarvis-specific in the Windows/shell environment.
# Precedence is per variable, highest first: the same variable exported in the
# shell that starts LabJarvis > saved Settings choice > this .env file > default.
# .env is re-read on every start, so a key edited here applies after Restart in
# Settings - unless the same variable is exported in the launcher's shell, which
# the launcher and Settings both warn about. Lines here for settings the Settings
# page manages have no effect once a configuration has been saved there.
# LABJARVIS_IGNORE_SAVED_SETTINGS=true ignores the saved file (tasks.py demo sets it).

# --- Runtime -----------------------------------------------------------------
# development | test | production (production refuses study mode).
LABJARVIS_APP_ENV=development
# fake (deterministic fixtures, default) | local | hosted
LABJARVIS_MODEL_MODE=fake
# Declared but not currently read by any entry point: `tasks.py dev` and the
# container both start Uvicorn on 127.0.0.1:8000 / 0.0.0.0:8000 explicitly.
LABJARVIS_HOST=127.0.0.1
LABJARVIS_PORT=8000
LABJARVIS_DATA_DIR=.labjarvis
# Backups default to <data dir>/backups.
# LABJARVIS_BACKUP_DIR=
LABJARVIS_MODEL_CACHE_DIR=.labjarvis/models
LABJARVIS_DATABASE_URL=sqlite+pysqlite:///.labjarvis/labjarvis.db
LABJARVIS_RETAIN_RAW_MEDIA=false
LABJARVIS_RETAIN_TRANSCRIPTS=true
LABJARVIS_WAKE_PHRASE=Jarvis
LABJARVIS_ALLOW_MODEL_DOWNLOAD=false
LABJARVIS_ALLOW_REMOTE_MODEL_SERVICE=false

# --- Local speech (faster-whisper) --------------------------------------------
LABJARVIS_SPEECH_MODEL_NAME=small.en
LABJARVIS_SPEECH_DEVICE=cpu
LABJARVIS_SPEECH_COMPUTE_TYPE=int8
LABJARVIS_SPEECH_LANGUAGE=en
LABJARVIS_SPEECH_BEAM_SIZE=5
# GPU profile (verified on an RTX 4050, see docs/models/gpu-setup.md):
#   LABJARVIS_SPEECH_DEVICE=cuda  LABJARVIS_SPEECH_COMPUTE_TYPE=float16  LABJARVIS_VISION_GPU=true
# Protocol-conditioned recognition from the approved version's vocabulary:
# off | prompt | hotwords (no measured benefit on synthetic speech; off by default).
LABJARVIS_SPEECH_CONDITIONING=off

# --- Local text (Ollama) --------------------------------------------------------
LABJARVIS_TEXT_MODEL_NAME=qwen2.5:3b
LABJARVIS_OLLAMA_BASE_URL=http://127.0.0.1:11434
LABJARVIS_TEXT_CONTEXT_TOKENS=4096

# --- Local vision (EasyOCR) and scanned-protocol OCR ------------------------------
LABJARVIS_VISION_MODEL_NAME=english_g2
LABJARVIS_VISION_LANGUAGES=["en"]
LABJARVIS_VISION_GPU=false
LABJARVIS_DOCUMENT_OCR_DPI=150
LABJARVIS_DOCUMENT_OCR_MAX_PAGE_PIXELS=8000000
LABJARVIS_DOCUMENT_OCR_MAX_TOTAL_PIXELS=80000000
# A PDF page with fewer extracted characters than this is treated as image-only.
LABJARVIS_DOCUMENT_MIN_TEXT_CHARACTERS_PER_PAGE=8

# --- Text interpretation ----------------------------------------------------------
# Blank = rules in fake mode, cascade otherwise. cascade: deterministic grammar
# first, the language model only for phrasings the grammar does not know.
# Also: rules, llm, agreement.
LABJARVIS_TEXT_INTERPRETER=
# auto disables "thinking" for thinking models (qwen3, deepseek-r1, ...). auto | on | off
LABJARVIS_TEXT_THINK=auto
# Blank uses the per-model profile timeout (20 s for local models).
LABJARVIS_TEXT_TIMEOUT_SECONDS=
LABJARVIS_TEXT_TEMPERATURE=0.0
LABJARVIS_TEXT_MAX_OUTPUT_TOKENS=128
# Include the development-split few-shot examples in the prompt.
LABJARVIS_TEXT_FEW_SHOT=true
# Optional second model that must agree with every LLM-routed state change.
# Local Ollama by default; it may instead run on its own hosted endpoint:
#   LABJARVIS_TEXT_VERIFIER_PROVIDER=openai            (or openai_compatible)
#   LABJARVIS_TEXT_VERIFIER_MODEL_NAME=gpt-5.4-nano
#   LABJARVIS_TEXT_VERIFIER_REASONING_EFFORT=none
#   LABJARVIS_TEXT_VERIFIER_BASE_URL=                  (required for openai_compatible)
#   LABJARVIS_TEXT_VERIFIER_API_KEY=<secret store>     (falls back to the text key)
#   LABJARVIS_TEXT_VERIFIER_PROVIDER_LABEL=OpenAI
#   LABJARVIS_TEXT_VERIFIER_STRUCTURED_OUTPUT=
#   LABJARVIS_TEXT_VERIFIER_EXTRA_BODY=
# A hosted verifier sends utterance text off this machine and needs
# LABJARVIS_ALLOW_HOSTED_MODELS=true.
LABJARVIS_TEXT_VERIFIER_MODEL_NAME=
LABJARVIS_TEXT_VERIFIER_PROVIDER=

# --- Hands-free operation ------------------------------------------------------------
# ONE SWITCH for the whole hands-free bench workflow (ADR 0018). Turns on, together:
# listening, autostart, voice-only confirmation, the high-integrity cross-check
# (default local model base.en - the only place a default model name is allowed),
# live label scan (local OCR only), warm-up on startup and timer alarms.
# Startup is REFUSED with the exact reason when a required local model is missing.
# Setting one of those flags to false while the profile is on is refused too.
LABJARVIS_HANDS_FREE_PROFILE=false
# Start listening as soon as a session screen opens, after the single tap
# ("Tap once to start hands-free") that browsers require. With
# `python scripts/tasks.py hands-free` (kiosk launch, localhost only) no tap is needed.
LABJARVIS_HANDS_FREE_AUTOSTART=false
# Timer alarms: "Timer ... is done" is spoken with a tone, repeated until
# acknowledged ("Jarvis, stop the alarm" / "Jarvis, timer done" / Stop alarm button).
# Alarms are derived from server timer state, so they survive a reload.
LABJARVIS_TIMER_ALARMS_ENABLED=false
LABJARVIS_TIMER_ALARM_REPEAT_SECONDS=20
# Spoken warnings at these seconds remaining (JSON list), unless muted.
LABJARVIS_TIMER_WARNING_SECONDS=[60,10]
# Opt-in and WEAKER than a value read-back: "Jarvis, confirm observation" commits a
# dictated observation after LabJarvis reads it back, only if both transcriptions of
# the dictation agreed. Needs voice-only confirmation.
LABJARVIS_VOICE_OBSERVATIONS_ENABLED=false
# How much LabJarvis says: full (everything on screen) or brief (the outcome and
# the phrase to say).
LABJARVIS_SPOKEN_DETAIL=full
# Who speaks responses: kokoro (local neural voice, recommended; chosen in Settings)
# or browser (the browser's own voice, also the automatic fallback). See ADR 0020.
# Kokoro needs `python scripts/setup_models.py kokoro` (about 350 MB, verified).
LABJARVIS_SPEECH_OUTPUT=browser
# English Kokoro voice, e.g. af_heart, am_michael, bf_emma, bm_george.
LABJARVIS_KOKORO_VOICE=af_heart
LABJARVIS_KOKORO_SPEED=1.0
# Background warm-up of local models after startup (never blocks the API).
LABJARVIS_WARM_MODELS_ON_STARTUP=false
# Optional in-browser voice-activity listener; the wake phrase is required.
LABJARVIS_HANDS_FREE_LISTENING_ENABLED=false
# Voice-only operation (no pedal): the listener may also answer a waiting
# proposal, but ONLY with a value-bearing reply that starts with the wake phrase
# ("Jarvis, confirm 10 millilitres", "Jarvis, confirm step 3", "Jarvis, confirm
# ethanol"). A bare "yes" never commits; a mismatching label can only be
# rejected. Needs hands-free listening AND the high-integrity cross-check.
LABJARVIS_VOICE_ONLY_CONFIRMATION_ENABLED=false
# Live "scan until stable" label checking: probe the camera with the LOCAL OCR
# every interval until N consecutive readings agree, then submit those frames as
# an ordinary pending reading (still needs confirmation). Refused at startup when
# the vision stage is hosted. Probes are never recorded.
LABJARVIS_LIVE_LABEL_SCAN_ENABLED=false
LABJARVIS_LIVE_SCAN_REQUIRED_CONSECUTIVE=3
LABJARVIS_LIVE_SCAN_INTERVAL_MS=400
LABJARVIS_LIVE_SCAN_TIMEOUT_SECONDS=12

# --- Selective high-integrity transcription ------------------------------------------
# A second reading of utterances that could change the record (and of every
# spoken confirmation). When the two readings disagree about a number, unit or
# negation, nothing is recorded. Required for spoken read-back and voice-only
# confirmation. Runs on the same provider as the speech stage, so the model name
# is a Whisper size locally (e.g. base.en) or a hosted transcription model
# (e.g. gpt-4o-mini-transcribe). No default, so recorded results stay reproducible.
# See docs/architecture/decisions/0012-selective-high-integrity-transcription.md
LABJARVIS_HIGH_INTEGRITY_TRANSCRIPTION_ENABLED=false
LABJARVIS_HIGH_INTEGRITY_TRANSCRIPTION_MODEL_NAME=

# --- Hosted model execution -------------------------------------------------------------
# Local-first remains the default. A hosted stage sends that stage's input (audio,
# transcript context or label images) to the configured provider, so it must be
# opted into explicitly. See ADR 0010 and ADR 0016.
LABJARVIS_ALLOW_HOSTED_MODELS=false
# Provider used by LABJARVIS_MODEL_MODE=hosted: openai | openai_compatible
LABJARVIS_HOSTED_PROVIDER=openai
# Supply keys through the environment or a secret manager. Never commit one,
# and never enter one in the browser: keys stay server-side by design.
# LABJARVIS_HOSTED_API_KEY=
LABJARVIS_HOSTED_BASE_URL=https://api.openai.com/v1
# Required for every hosted stage; no defaults, so the exact model behind any
# recorded result stays reproducible when provider aliases move.
LABJARVIS_HOSTED_SPEECH_MODEL_NAME=
LABJARVIS_HOSTED_TEXT_MODEL_NAME=
LABJARVIS_HOSTED_VISION_MODEL_NAME=
LABJARVIS_HOSTED_MAX_RESPONSE_BYTES=1048576
LABJARVIS_HOSTED_MAX_RETRIES=2
# Example: fully hosted OpenAI (verified end to end on 2026-09-27)
#   LABJARVIS_MODEL_MODE=hosted
#   LABJARVIS_ALLOW_HOSTED_MODELS=true
#   LABJARVIS_HOSTED_SPEECH_MODEL_NAME=gpt-4o-mini-transcribe
#   LABJARVIS_HOSTED_TEXT_MODEL_NAME=gpt-5.4-nano
#   LABJARVIS_HOSTED_TEXT_REASONING_EFFORT=none
#   LABJARVIS_HOSTED_VISION_MODEL_NAME=gpt-5.4-nano

# --- Named hosted providers: OpenAI and DeepSeek, configured side by side ---------------
# Each has its own key, endpoint and options, so both can be configured at once and
# Settings can choose either for the text stage (OpenAI also for speech and vision).
# Choosing OpenAI always uses OpenAI's endpoint and key; choosing DeepSeek always uses
# DeepSeek's. The OpenAI key falls back to LABJARVIS_HOSTED_API_KEY.
# LABJARVIS_OPENAI_API_KEY=
# LABJARVIS_OPENAI_BASE_URL=            (default: LABJARVIS_HOSTED_BASE_URL, i.e. OpenAI)
# LABJARVIS_DEEPSEEK_API_KEY=
LABJARVIS_DEEPSEEK_BASE_URL=https://api.deepseek.com
# json_schema | json_object | prompt_only (answers are validated strictly either way)
LABJARVIS_DEEPSEEK_TEXT_STRUCTURED_OUTPUT=json_object
# Sent with every DeepSeek request; disables thinking mode, as in all recorded runs.
LABJARVIS_DEEPSEEK_TEXT_EXTRA_BODY={"thinking": {"type": "disabled"}}

# --- Per-stage providers (hybrid) and generic OpenAI-compatible endpoints ----------------
# The per-stage base URL / key overrides below apply to the generic
# openai_compatible provider (GLM, a local server, ...), never to OpenAI or DeepSeek.
# Each stage may run on: fake | local | openai | openai_compatible. Unset follows
# LABJARVIS_MODEL_MODE. Hosted stages still need LABJARVIS_ALLOW_HOSTED_MODELS,
# a key and an explicit model identifier. Nothing vendor-specific is compiled in.
LABJARVIS_SPEECH_PROVIDER=
LABJARVIS_TEXT_PROVIDER=
LABJARVIS_VISION_PROVIDER=
# Per-stage endpoint, key and display label; unset stages use
# LABJARVIS_HOSTED_BASE_URL / LABJARVIS_HOSTED_API_KEY.
LABJARVIS_HOSTED_SPEECH_BASE_URL=
LABJARVIS_HOSTED_TEXT_BASE_URL=
LABJARVIS_HOSTED_VISION_BASE_URL=
# LABJARVIS_HOSTED_SPEECH_API_KEY=
# LABJARVIS_HOSTED_TEXT_API_KEY=
# LABJARVIS_HOSTED_VISION_API_KEY=
LABJARVIS_HOSTED_SPEECH_PROVIDER_LABEL=
LABJARVIS_HOSTED_TEXT_PROVIDER_LABEL=
LABJARVIS_HOSTED_VISION_PROVIDER_LABEL=
# Capabilities an OpenAI-compatible endpoint must declare; chat compatibility
# does not imply either, and startup fails if a stage needs an undeclared one.
LABJARVIS_HOSTED_SPEECH_TRANSCRIPTION=false
LABJARVIS_HOSTED_VISION_IMAGE_INPUT=false
# json_schema | json_object | prompt_only (default: json_schema for OpenAI,
# json_object for compatible endpoints). Output is always validated strictly.
LABJARVIS_HOSTED_TEXT_STRUCTURED_OUTPUT=
# Provider-specific JSON merged into each hosted text request; may not override
# model, messages, tools, tool_choice, functions or stream.
LABJARVIS_HOSTED_TEXT_EXTRA_BODY=
# max_tokens | max_completion_tokens (name of the output-limit field on /chat/completions)
LABJARVIS_HOSTED_TEXT_TOKEN_LIMIT_FIELD=max_tokens
LABJARVIS_HOSTED_TEXT_MAX_OUTPUT_TOKENS=256
# Reasoning effort for hosted reasoning models (none|minimal|low|medium|high|xhigh|max).
# Blank sends nothing (provider default). Use only values the provider documents
# for that model; an unsupported value is rejected and nothing is proposed.
LABJARVIS_HOSTED_TEXT_REASONING_EFFORT=
# Example: local Whisper + local EasyOCR + a hosted DeepSeek text model
#   LABJARVIS_MODEL_MODE=local
#   LABJARVIS_TEXT_PROVIDER=openai_compatible
#   LABJARVIS_ALLOW_HOSTED_MODELS=true
#   LABJARVIS_HOSTED_TEXT_BASE_URL=https://api.deepseek.com
#   LABJARVIS_HOSTED_TEXT_MODEL_NAME=deepseek-flash
#   LABJARVIS_HOSTED_TEXT_PROVIDER_LABEL=DeepSeek
#   LABJARVIS_HOSTED_TEXT_EXTRA_BODY={"thinking": {"type": "disabled"}}
#   LABJARVIS_HOSTED_TEXT_API_KEY=<from your secret store>
# Example: GLM (Z.ai) text with local speech and vision
#   LABJARVIS_TEXT_PROVIDER=openai_compatible
#   LABJARVIS_HOSTED_TEXT_BASE_URL=https://api.z.ai/api/paas/v4
#   LABJARVIS_HOSTED_TEXT_MODEL_NAME=glm-4.5-air
#   LABJARVIS_HOSTED_TEXT_EXTRA_BODY={"thinking": {"type": "disabled"}}
# A LOCAL OpenAI-compatible server (vLLM, llama.cpp, LM Studio) on 127.0.0.1 /
# localhost is shown and recorded as local, not hosted:
#   LABJARVIS_TEXT_PROVIDER=openai_compatible
#   LABJARVIS_HOSTED_TEXT_BASE_URL=http://127.0.0.1:1234/v1
# Model names and URLs change: check the provider's documentation.

# --- Realtime voice (optional, OpenAI only, paid) -----------------------------------------
# A bounded conversational shell over the same tool gateway the UI buttons use.
# It can propose actions and read approved protocol state aloud; it can never
# commit a record without the confirmation policy that applies to every other
# caller. Off by default. See ADR 0011. Needs a hosted OpenAI key.
LABJARVIS_REALTIME_ENABLED=false
# Required when realtime is enabled (e.g. gpt-realtime-2.1-mini); no default.
LABJARVIS_REALTIME_MODEL_NAME=
# webrtc is preferred in a browser; websocket exists for where WebRTC is blocked.
LABJARVIS_REALTIME_TRANSPORT=webrtc
LABJARVIS_REALTIME_VOICE=alloy
# Lifetime of the ephemeral credential handed to the browser.
LABJARVIS_REALTIME_SESSION_TTL_SECONDS=60
LABJARVIS_REALTIME_MAX_UTTERANCE_SECONDS=30
# How long the browser records the operator answering a proposal out loud.
LABJARVIS_REALTIME_CONFIRMATION_SECONDS=5
LABJARVIS_REALTIME_IDLE_TIMEOUT_SECONDS=300

# --- Study mode (seeded-error trials for a consented study; never in production) ---------
# Needs BOTH a study script and the exact acknowledgement phrase
# SEEDED-ERRORS-FOR-A-CONSENTED-STUDY. See research/study and HUMAN_ACTIONS_REQUIRED.md (H4).
# LABJARVIS_STUDY_MODE_SCRIPT=research/study/private/plan/P01-block1-tap.json
LABJARVIS_STUDY_MODE_ACKNOWLEDGEMENT=

# --- Limits, thresholds, network and logging ----------------------------------------------
LABJARVIS_MAX_DOCUMENT_BYTES=10485760
LABJARVIS_MAX_DOCUMENT_PAGES=100
LABJARVIS_MAX_DOCX_UNCOMPRESSED_BYTES=52428800
LABJARVIS_MAX_DOCX_ENTRIES=2000
LABJARVIS_MAX_EXTRACTED_CHARACTERS=1000000
LABJARVIS_MAX_AUDIO_BYTES=15728640
LABJARVIS_MAX_IMAGE_BYTES=10485760
LABJARVIS_INFERENCE_TIMEOUT_SECONDS=45
LABJARVIS_INFERENCE_CONCURRENCY=1
LABJARVIS_COMMAND_CONFIDENCE_THRESHOLD=0.75
LABJARVIS_REAGENT_MATCH_THRESHOLD=92
LABJARVIS_REAGENT_UNCERTAIN_THRESHOLD=72
LABJARVIS_CORS_ORIGINS=["http://127.0.0.1:5173"]
LABJARVIS_ALLOWED_HOSTS=["127.0.0.1","localhost","testserver"]
LABJARVIS_LOG_LEVEL=INFO
# json | console
LABJARVIS_LOG_FORMAT=json
# Optional immutable deployment revision included in JSON exports and backups.
LABJARVIS_APPLICATION_COMMIT=
